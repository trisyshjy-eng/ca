# Copy this file to .env and fill in real values.

# Supabase: Project Settings > Database > Connection string
# DATABASE_URL = "Connection pooling" string (port 6543, pgbouncer) — used at runtime
# DIRECT_URL   = "Direct connection" string (port 5432) — used by `prisma migrate`
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Random secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32-byte-base64-secret"
